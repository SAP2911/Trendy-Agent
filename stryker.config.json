{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "packageManager": "npm",
  "testRunner": "vitest",
  "reporters": ["clear-text", "progress", "html"],
  "coverageAnalysis": "perTest",
  "mutate": [
    "lib/policy/**/*.ts",
    "lib/guards/**/*.ts"
  ],
  "thresholds": {
    "high": 90,
    "low": 85,
    "break": 90
  },
  "timeoutMS": 15000,
  "timeoutFactor": 2
}
